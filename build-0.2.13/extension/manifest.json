{
  "manifest_version": 3,
  "name": "Pyrite",
  "description": "Checks whether a memecoin's site and X claims are true.",
  "version": "0.2.13",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  },
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "icon/16.png",
      "32": "icon/32.png",
      "48": "icon/48.png",
      "128": "icon/128.png"
    },
    "default_title": "Pyrite",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.axiom.trade/*",
        "https://axiom.trade/*"
      ],
      "run_at": "document_end",
      "js": [
        "content-scripts/content.js"
      ]
    }
  ]
}